# NexSon Backend – Environment Variables
# Copy this file to .env on the server and fill in the real values.
# Never commit the real .env file.

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/nexson?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# Node backend
PORT=3001
ALLOWED_ORIGIN=https://nexusproject2077.github.io

# NexSon Music Service
MUSIC_PORT=5000

# Legacy YouTube Data API v3 key (not used by the music service anymore).
# Keep it in the existing VPS .env until that configuration is intentionally cleaned up.
YOUTUBE_API_KEY=replace_with_your_youtube_data_api_key

# Absolute VPS path to a Netscape-format cookies.txt export from YouTube.
# Keep this file outside the repository and restrict it to the service user.
YOUTUBE_COOKIEFILE=/etc/nexson/youtube-cookies.txt
